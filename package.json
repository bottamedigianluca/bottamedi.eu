  "scripts": {
    "dev": "node scripts/generate-blog-index.mjs && vite",
    "build": "node scripts/generate-blog-index.mjs && vite-react-ssg build && node scripts/inject-post-seo.mjs && node scripts/generate-feeds.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --quiet",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "blog:new": "node scripts/new-post.mjs",
    "blog:validate": "node scripts/validate-posts.mjs",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie <= 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
